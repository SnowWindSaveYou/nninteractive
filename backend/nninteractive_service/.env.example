# nnInteractive Unity Backend 配置
#
# 用法:复制本文件为 .env,按实际环境修改值。
#   cp .env.example .env
# 启动服务时会自动加载同目录下的 .env。
#
# 优先级:真实环境变量 > .env 文件 > 代码默认值。
# 即:若已在系统环境变量里设了同名变量,.env 里的值不生效(被 env 覆盖)。
# 这方便容器化/临时调试时用 env 覆盖单个参数,而不改 .env。
#
# 详见 DEPLOY.md。

# ──────────────────────────────────────────────────────────────
# 运行引擎
# ──────────────────────────────────────────────────────────────
# mock   = 无 AI 联调/单元测试(不跑真实推理)
# local  = 本机 GPU 跑 nnInteractive(生产用)
# remote = 转发到官方 nninteractive-server(本机无 GPU)
NNINTERACTIVE_BACKEND_ENGINE=local

# ──────────────────────────────────────────────────────────────
# 服务数据目录(mask、中间结果存放)
# ──────────────────────────────────────────────────────────────
NNINTERACTIVE_BACKEND_DATA_DIR=/workspace/data/nninteractive_backend

# session 空闲超时(秒),超时自动回收
NNINTERACTIVE_BACKEND_SESSION_TTL=3600

# ──────────────────────────────────────────────────────────────
# 安全:允许读取影像的数据根目录白名单
# ──────────────────────────────────────────────────────────────
# register case 时的 image_uri 路径必须落在这些目录下,否则拒绝。
# 逗号分隔多个。Windows UNC 共享路径示例:\\10.8.83.82\nfs
# 注意:反斜杠在 .env 里无需转义,直接写 \\server\share 即可。
NNINTERACTIVE_BACKEND_ALLOWED_DATA_ROOTS=/workspace,/tmp

# 单个体积最大体素数(防止误传超大文件撑爆内存)
NNINTERACTIVE_BACKEND_MAX_VOXELS=536870912

# NIfTI series 目录最大文件数
NNINTERACTIVE_BACKEND_MAX_SERIES_FILES=2048

# ──────────────────────────────────────────────────────────────
# local 引擎参数(engine=local 时必填)
# ──────────────────────────────────────────────────────────────
# 模型目录绝对路径,应含 exported_model.onnx / plans.json / fold_0/checkpoint_final.pth
NNINTERACTIVE_BACKEND_LOCAL_MODEL_DIR=/data/nninteractive_models/nnInteractive_v1.0

# 设备:cuda:0 / cuda:1 / cpu
NNINTERACTIVE_BACKEND_LOCAL_DEVICE=cuda:0

# ──────────────────────────────────────────────────────────────
# remote 引擎参数(engine=remote 时必填)
# ──────────────────────────────────────────────────────────────
# 官方 nninteractive-server 地址
NNINTERACTIVE_BACKEND_REMOTE_URL=http://gpu-box:1527

# server 启用了 --api-key 时填写
NNINTERACTIVE_BACKEND_REMOTE_API_KEY=
